{
  "$defs": {
    "Agreed": {
      "additionalProperties": false,
      "description": "The seller's signed `CommitResult` verified and matched; the buyer kept it.",
      "properties": {
        "attributed": {
          "title": "Attributed",
          "type": "boolean"
        },
        "authentication_method": {
          "enum": [
            "web_bot_auth",
            "bearer"
          ],
          "title": "Authentication Method",
          "type": "string"
        },
        "commit_id": {
          "title": "Commit Id",
          "type": "integer"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/AssentEntry"
          },
          "title": "Entries",
          "type": "array"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "integer"
        },
        "keyid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Keyid"
        },
        "proposal_id": {
          "title": "Proposal Id",
          "type": "string"
        },
        "record_digest": {
          "title": "Record Digest",
          "type": "string"
        },
        "seller": {
          "$ref": "#/$defs/SellerView"
        },
        "state": {
          "const": "agreed",
          "default": "agreed",
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "seller",
        "authentication_method",
        "keyid",
        "record_digest",
        "entries",
        "attributed",
        "commit_id",
        "evidence_id"
      ],
      "title": "Agreed",
      "type": "object"
    },
    "Answer": {
      "additionalProperties": false,
      "description": "A response, as the buyer received and kept it.",
      "properties": {
        "body": {
          "$ref": "#/$defs/JsonValue"
        },
        "headers": {
          "$ref": "#/$defs/Headers"
        },
        "keyid": {
          "title": "Keyid",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "keyid",
        "headers",
        "body"
      ],
      "title": "Answer",
      "type": "object"
    },
    "AssentEntry": {
      "additionalProperties": false,
      "description": "The `AssentEntry` object of the `commercial` module.",
      "properties": {
        "at": {
          "$ref": "#/$defs/Instant",
          "description": "When the party wrote the entry, by its own statement. No rule reads order from it"
        },
        "ground": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssentEntryGround"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the seller declined. Core terms: `availability` | `exclusivity` | `terms`, the grounds of \u00a7 4.3.2. Absent on any other entry. A receiver that doesn't know a term still reads the entry as a `decline`"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlainString"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Buyer-generated, unique per `commit`, opaque, and scoped to one buyer and seller pair. The seller MUST NOT interpret it (\u00a7 5.6.1)"
        },
        "line_item_ids": {
          "description": "The line items the entry names. MUST be non-empty",
          "items": {
            "$ref": "#/$defs/PlainString"
          },
          "title": "Line Item Ids",
          "type": "array"
        },
        "record_digest": {
          "$ref": "#/$defs/Digest",
          "description": "Of the binding record for the line items in `line_item_ids[]` (\u00a7 4.1.1)"
        },
        "role": {
          "$ref": "#/$defs/AssentEntryRole",
          "description": "`commitment` | `acceptance` | `withdrawal` | `decline`. It says what the entry does, and it implies the party"
        },
        "version": {
          "$ref": "#/$defs/PlainInteger",
          "description": "The `version` of the record the digest was computed over. `version` is outside the binding record, so the entry binds it"
        }
      },
      "required": [
        "at",
        "line_item_ids",
        "record_digest",
        "role",
        "version"
      ],
      "title": "AssentEntry",
      "type": "object"
    },
    "AssentEntryGround": {
      "anyOf": [
        {
          "enum": [
            "availability",
            "exclusivity",
            "terms"
          ],
          "type": "string"
        },
        {
          "$ref": "#/$defs/NamespacedTerm"
        }
      ]
    },
    "AssentEntryRole": {
      "enum": [
        "commitment",
        "acceptance",
        "withdrawal",
        "decline"
      ],
      "type": "string"
    },
    "BothDigests": {
      "additionalProperties": false,
      "description": "Both parties' digest input, and the record_digest over it.",
      "properties": {
        "digest_input_bytes": {
          "title": "Digest Input Bytes",
          "type": "integer"
        },
        "record_digest": {
          "title": "Record Digest",
          "type": "string"
        }
      },
      "required": [
        "record_digest",
        "digest_input_bytes"
      ],
      "title": "BothDigests",
      "type": "object"
    },
    "BuyerSide": {
      "additionalProperties": false,
      "description": "The request as the buyer sent it, and the seller's signed answer as it arrived.",
      "properties": {
        "directory": {
          "anyOf": [
            {
              "$ref": "#/$defs/Directory"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "integer"
        },
        "request": {
          "$ref": "#/$defs/Message"
        },
        "response": {
          "$ref": "#/$defs/Answer"
        }
      },
      "required": [
        "evidence_id",
        "request",
        "response",
        "directory"
      ],
      "title": "BuyerSide",
      "type": "object"
    },
    "CfbotAccepted": {
      "additionalProperties": false,
      "description": "cfbot verified the signature (cfbot/server.mjs `verifyRequest`).",
      "properties": {
        "content_digest_matches": {
          "title": "Content Digest Matches",
          "type": "boolean"
        },
        "directory_signatures": {
          "items": {
            "$ref": "#/$defs/DirectorySignature"
          },
          "title": "Directory Signatures",
          "type": "array"
        },
        "identity": {
          "title": "Identity",
          "type": "string"
        },
        "keyid": {
          "title": "Keyid",
          "type": "string"
        },
        "nonce": {
          "title": "Nonce",
          "type": "string"
        },
        "ok": {
          "const": true,
          "title": "Ok",
          "type": "boolean"
        },
        "verifier": {
          "title": "Verifier",
          "type": "string"
        }
      },
      "required": [
        "ok",
        "verifier",
        "identity",
        "keyid",
        "nonce",
        "directory_signatures",
        "content_digest_matches"
      ],
      "title": "CfbotAccepted",
      "type": "object"
    },
    "CfbotRefused": {
      "additionalProperties": false,
      "description": "cfbot refused the signature, and why.",
      "properties": {
        "error": {
          "title": "Error",
          "type": "string"
        },
        "ok": {
          "const": false,
          "title": "Ok",
          "type": "boolean"
        }
      },
      "required": [
        "ok",
        "error"
      ],
      "title": "CfbotRefused",
      "type": "object"
    },
    "CloudflareCheck": {
      "additionalProperties": false,
      "description": "cfbot's answer to a request the buyer signed: its status and its verdict.",
      "properties": {
        "status": {
          "title": "Status",
          "type": "integer"
        },
        "verdict": {
          "discriminator": {
            "mapping": {
              "false": "#/$defs/CfbotRefused",
              "true": "#/$defs/CfbotAccepted"
            },
            "propertyName": "ok"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CfbotAccepted"
            },
            {
              "$ref": "#/$defs/CfbotRefused"
            }
          ],
          "title": "Verdict"
        }
      },
      "required": [
        "status",
        "verdict"
      ],
      "title": "CloudflareCheck",
      "type": "object"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "Directory": {
      "additionalProperties": false,
      "description": "A key directory response: as a party kept it, or as the runner fetched it.",
      "properties": {
        "expires": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires"
        },
        "fetched_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fetched At"
        },
        "headers": {
          "$ref": "#/$defs/Headers"
        },
        "keys": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Keys",
          "type": "array"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "status": {
          "title": "Status",
          "type": "integer"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "status",
        "headers",
        "keys"
      ],
      "title": "Directory",
      "type": "object"
    },
    "DirectorySignature": {
      "additionalProperties": false,
      "description": "A signature of the buyer's directory that cfbot verified.",
      "properties": {
        "keyid": {
          "title": "Keyid",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "label",
        "keyid"
      ],
      "title": "DirectorySignature",
      "type": "object"
    },
    "FlowRun": {
      "additionalProperties": false,
      "description": "One credential's run of the flow: signature or bearer.",
      "properties": {
        "buyer": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuyerSide"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/BothDigests"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/Agreed"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "proposal_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposal Id"
        },
        "reverify": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reverified"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "seller": {
          "anyOf": [
            {
              "$ref": "#/$defs/SellerSide"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "FlowRun",
      "type": "object"
    },
    "Headers": {
      "additionalProperties": false,
      "description": "Header lines in order, lowercased, without the withheld fields; and which were withheld.",
      "properties": {
        "lines": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Lines",
          "type": "array"
        },
        "withheld": {
          "items": {
            "type": "string"
          },
          "title": "Withheld",
          "type": "array"
        }
      },
      "required": [
        "lines",
        "withheld"
      ],
      "title": "Headers",
      "type": "object"
    },
    "Instant": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "JsonValue": {},
    "Message": {
      "additionalProperties": false,
      "description": "A request, as a party sent or kept it.",
      "properties": {
        "body": {
          "$ref": "#/$defs/JsonValue"
        },
        "headers": {
          "$ref": "#/$defs/Headers"
        },
        "keyid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Keyid"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "method",
        "url",
        "keyid",
        "headers",
        "body"
      ],
      "title": "Message",
      "type": "object"
    },
    "NamespacedTerm": {
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*:[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "Origin": {
      "description": "https://<host>",
      "title": "Origin",
      "type": "string"
    },
    "Parties_Origin_": {
      "additionalProperties": false,
      "properties": {
        "buyer": {
          "$ref": "#/$defs/Origin"
        },
        "cfbot": {
          "$ref": "#/$defs/Origin"
        },
        "seller": {
          "$ref": "#/$defs/Origin"
        }
      },
      "required": [
        "seller",
        "buyer",
        "cfbot"
      ],
      "title": "Parties[Origin]",
      "type": "object"
    },
    "Parties_Union_Directory__NoneType__": {
      "additionalProperties": false,
      "properties": {
        "buyer": {
          "anyOf": [
            {
              "$ref": "#/$defs/Directory"
            },
            {
              "type": "null"
            }
          ]
        },
        "cfbot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Directory"
            },
            {
              "type": "null"
            }
          ]
        },
        "seller": {
          "anyOf": [
            {
              "$ref": "#/$defs/Directory"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "seller",
        "buyer",
        "cfbot"
      ],
      "title": "Parties[Union[Directory, NoneType]]",
      "type": "object"
    },
    "PlainInteger": {
      "ge": -9007199254740991,
      "le": 9007199254740991,
      "type": "integer"
    },
    "PlainString": {
      "type": "string"
    },
    "Reverified": {
      "additionalProperties": false,
      "description": "Both kept messages, verified again offline from the stored bytes.",
      "properties": {
        "request_components": {
          "items": {
            "type": "string"
          },
          "title": "Request Components",
          "type": "array"
        },
        "response_bound": {
          "title": "Response Bound",
          "type": "boolean"
        },
        "response_components": {
          "items": {
            "type": "string"
          },
          "title": "Response Components",
          "type": "array"
        }
      },
      "required": [
        "request_components",
        "response_components",
        "response_bound"
      ],
      "title": "Reverified",
      "type": "object"
    },
    "SellerSide": {
      "additionalProperties": false,
      "description": "What the seller's boundary resolved for the commit, and the signed request it kept.",
      "properties": {
        "attributed": {
          "title": "Attributed",
          "type": "boolean"
        },
        "authentication_method": {
          "enum": [
            "web_bot_auth",
            "bearer"
          ],
          "title": "Authentication Method",
          "type": "string"
        },
        "directory": {
          "anyOf": [
            {
              "$ref": "#/$defs/Directory"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "principal_id": {
          "title": "Principal Id",
          "type": "string"
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/Message"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "principal_id",
        "authentication_method",
        "attributed"
      ],
      "title": "SellerSide",
      "type": "object"
    },
    "SellerView": {
      "additionalProperties": false,
      "description": "The seller an outcome is about, as the buyer's own records hold it.",
      "properties": {
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "legal_name": {
          "title": "Legal Name",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        }
      },
      "required": [
        "origin",
        "domain",
        "legal_name"
      ],
      "title": "SellerView",
      "type": "object"
    },
    "Software": {
      "additionalProperties": false,
      "description": "The versions of the packages the runner verifies with; None when one isn't installed.",
      "properties": {
        "iab_agentic_primitives": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Iab Agentic Primitives"
        },
        "openproposal_sdk": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Openproposal Sdk"
        }
      },
      "required": [
        "iab_agentic_primitives",
        "openproposal_sdk"
      ],
      "title": "Software",
      "type": "object"
    },
    "StepResult": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Detail"
        },
        "group": {
          "enum": [
            "directory",
            "signature",
            "bearer",
            "cloudflare",
            "publish"
          ],
          "title": "Group",
          "type": "string"
        },
        "id": {
          "enum": [
            "directory-seller",
            "directory-buyer",
            "directory-cfbot",
            "signature-issue",
            "signature-commit",
            "signature-seller",
            "signature-buyer",
            "signature-digest",
            "signature-reverify",
            "bearer-issue",
            "bearer-commit",
            "bearer-seller",
            "bearer-buyer",
            "bearer-digest",
            "cloudflare",
            "publish"
          ],
          "title": "Id",
          "type": "string"
        },
        "ms": {
          "title": "Ms",
          "type": "integer"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "group",
        "title",
        "ok",
        "ms",
        "detail"
      ],
      "title": "StepResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bearer": {
      "anyOf": [
        {
          "$ref": "#/$defs/FlowRun"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cloudflare": {
      "anyOf": [
        {
          "$ref": "#/$defs/CloudflareCheck"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "directories": {
      "anyOf": [
        {
          "$ref": "#/$defs/Parties_Union_Directory__NoneType__"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "duration_ms": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Ms"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "format": {
      "const": 3,
      "default": 3,
      "title": "Format",
      "type": "integer"
    },
    "line_item_ids": {
      "items": {
        "type": "string"
      },
      "title": "Line Item Ids",
      "type": "array"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "origins": {
      "anyOf": [
        {
          "$ref": "#/$defs/Parties_Origin_"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "signature": {
      "anyOf": [
        {
          "$ref": "#/$defs/FlowRun"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "software": {
      "anyOf": [
        {
          "$ref": "#/$defs/Software"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/StepResult"
      },
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "started_at",
    "ok",
    "steps"
  ],
  "title": "Report",
  "type": "object"
}
